				{
					"name": "GET - List Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Response tiene data de usuarios\", function () {\r",
									"    const json = pm.response.json();\r",
									"    pm.expect(json.data).to.be.an(\"array\");\r",
									"    pm.expect(json.data.length).to.be.greaterThan(0);\r",
									"});\r",
									"\r",
									"pm.test(\"Tiempo de respuesta menor a 2000ms\", function () {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
									"});\r",
									"\r",
									"pm.test(\"Content-Type es application/json\", function () {\r",
									"    pm.response.to.have.header(\"Content-Type\");\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
